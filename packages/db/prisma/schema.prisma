// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int              @id @default(autoincrement())
  name          String
  email         String           @unique
  password      String
  rooms         Room[]           @relation("RoomAdmin")
  chats         Chat[]           @relation("UserChats")
  memberships   RoomMembership[]
  tags          Tag[]
  aiOutputs     AIOutput[]
  refreshTokens RefreshToken[]
}

model Room {
  id          Int              @id @default(autoincrement())
  slug        String           @unique
  title       String           @default("Untitled")
  content     String           @default("")
  isArchived  Boolean          @default(false)
  isPublic    Boolean          @default(false)
  shareId     String?          @unique
  adminId     Int
  admin       User             @relation("RoomAdmin", fields: [adminId], references: [id])
  chats       Chat[]
  documentId  String?          @unique
  document    Document?        @relation(fields: [documentId], references: [id])
  members     RoomMembership[]
  secretCode  String           @unique
  tags        NoteTag[]
  aiOutputs   AIOutput[]       @relation("RoomAIOutputs")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Chat {
  id        Int      @id @default(autoincrement())
  roomId    Int
  senderId  Int
  sender    User     @relation("UserChats", fields: [senderId], references: [id])
  message   String
  timestamp DateTime @default(now())
  room      Room     @relation(fields: [roomId], references: [id])
}

model Document {
  id        String   @id
  content   Bytes
  updatedAt DateTime @updatedAt
  room      Room?
}

model RoomMembership {
  id     Int  @id @default(autoincrement())
  user   User @relation(fields: [userId], references: [id])
  userId Int
  room   Room @relation(fields: [roomId], references: [id])
  roomId Int

  @@unique([userId, roomId])
}

// ─── New Peblo Features ──────────────────────────────────────────────────────

model Tag {
  id        String    @id @default(cuid())
  name      String
  userId    Int
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes     NoteTag[]

  @@unique([name, userId])
}

model NoteTag {
  noteId Int
  tagId  String

  note   Room @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
}

model AIOutput {
  id         String   @id @default(cuid())
  roomId     Int
  userId     Int
  type       AIType
  inputHash  String
  output     Json
  tokensUsed Int      @default(0)
  createdAt  DateTime @default(now())

  room       Room     @relation("RoomAIOutputs", fields: [roomId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum AIType {
  SUMMARY
  ACTION_ITEMS
  TITLE_SUGGESTION
  GRAMMAR_CHECK
}
